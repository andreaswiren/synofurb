#!/bin/sh
# synofurb: write kernel + initrd to the raw boot area of every system disk (U-Boot boards).
# Layout follows the Debian wiki page "InstallingDebianOn/Synology":
#   kernel (uImage, DTB appended) at 10 MiB, initrd (uInitrd) at 20 MiB, first 50 MiB kept out of the GPT.
# Run automatically after every kernel / initramfs update.
set -eu
CONF=/etc/synofurb/uboot.conf
[ -r "$CONF" ] || { echo "synofurb-uboot-update: $CONF missing" >&2; exit 0; }
# shellcheck disable=SC1090
. "$CONF"    # SYSTEM_DISKS, DTB, ROOT_UUID, SERIAL_TTY, SERIAL_SPEED, KERNEL_MIB, INITRD_MIB, RESERVED_MIB
LOAD_KERNEL=${LOAD_KERNEL:-0x02000000}
LOAD_INITRD=${LOAD_INITRD:-0x03000000}
EXTRA_ARGS=${EXTRA_ARGS:-rootdelay=10 earlyprintk=serial}
KVER=$(ls -1 /boot/vmlinuz-* 2>/dev/null | sed 's|/boot/vmlinuz-||' | sort -V | tail -n1)
[ -n "$KVER" ] || { echo "no kernel in /boot" >&2; exit 0; }
INITRD=/boot/initrd.img-$KVER
[ -f "$INITRD" ] || { echo "initrd for $KVER not built yet" >&2; exit 0; }
DTBFILE=""
for d in "/usr/lib/linux-image-$KVER" "/usr/lib/linux-image-${KVER%-*}" /etc/synofurb; do
  [ -f "$d/$DTB" ] && DTBFILE="$d/$DTB" && break
done
[ -n "$DTBFILE" ] || { echo "DTB '$DTB' not found for kernel $KVER. Put your board's .dtb in /etc/synofurb/ and re-run." >&2; exit 1; }
T=$(mktemp -d)
trap 'rm -rf "$T"' EXIT
cat "/boot/vmlinuz-$KVER" "$DTBFILE" > "$T/zImage.fdt"
mkimage -A arm -O linux -T kernel -C none -a 0x00008000 -e 0x00008000 -n "Debian $KVER" -d "$T/zImage.fdt" "$T/uImage" >/dev/null
mkimage -A arm -O linux -T ramdisk -C none -a 0 -e 0 -n "initrd $KVER" -d "$INITRD" "$T/uInitrd" >/dev/null
KS=$(stat -c %s "$T/uImage"); IS=$(stat -c %s "$T/uInitrd")
MAXK=$(( (INITRD_MIB - KERNEL_MIB) * 1048576 )); MAXI=$(( (RESERVED_MIB - INITRD_MIB) * 1048576 ))
[ "$KS" -le "$MAXK" ] || { echo "kernel image ($KS bytes) does not fit in $MAXK bytes" >&2; exit 1; }
[ "$IS" -le "$MAXI" ] || { echo "initrd ($IS bytes) does not fit in $MAXI bytes" >&2; exit 1; }
for disk in $SYSTEM_DISKS; do
  [ -b "$disk" ] || { echo "skip $disk (not present)"; continue; }
  dd if="$T/uImage"  of="$disk" bs=1M seek="$KERNEL_MIB" conv=notrunc status=none
  dd if="$T/uInitrd" of="$disk" bs=1M seek="$INITRD_MIB" conv=notrunc status=none
  echo "wrote kernel $KVER + initrd to $disk"
done
hex() { printf '0x%x' "$1"; }
KB=$(hex $(( KERNEL_MIB * 2048 ))); IB=$(hex $(( INITRD_MIB * 2048 )))
KC=$(hex $(( (KS + 511) / 512 ))); IC=$(hex $(( (IS + 511) / 512 )))
cat > /boot/uboot-env.txt <<ENV
# U-Boot recipe generated by synofurb for kernel $KVER ($(date -u +%F)).
# Interrupt U-Boot on the serial console ($SERIAL_TTY, ${SERIAL_SPEED} baud, 8N1) with Ctrl+C, then paste:
setenv load_image_addr $LOAD_KERNEL
setenv load_initrd_addr $LOAD_INITRD
setenv sf_bootargs 'console=$SERIAL_TTY,$SERIAL_SPEED root=UUID=$ROOT_UUID $EXTRA_ARGS'
setenv sf_load 'scsi scan; scsi read \${load_image_addr} $KB $KC; scsi read \${load_initrd_addr} $IB $IC'
setenv sf_boot 'setenv bootargs \${sf_bootargs}; run sf_load; bootm \${load_image_addr} \${load_initrd_addr}'
# Test it first (does not change anything permanently):
run sf_boot
# If Debian comes up, make it permanent. Keep the original bootcmd as a fallback ('bootspi' starts DSM):
#   printenv bootcmd          <- write the old value down first!
#   setenv bootcmd 'run sf_boot; bootspi'
#   saveenv
# Some Marvell boards (e.g. DS218j) need an extra memory write in bootcmd; see the Debian wiki page
# https://wiki.debian.org/InstallingDebianOn/Synology
ENV
echo "U-Boot recipe written to /boot/uboot-env.txt"
