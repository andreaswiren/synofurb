#!/bin/sh
# Generate /etc/inittab. Runs once from /init, after /proc and /sys are mounted.
#
# Consoles: the kernel lists every console it actually registered in /sys/class/tty/console/active
# (e.g. "tty0 ttyS0"). That includes serial consoles given as console=uart8250,mmio32,0xfedc9000,...
# which the kernel exposes as an ordinary ttyS<N>. We put a root shell on each of them (no getty,
# no login: physical console access is root, same as the kernel's own console).
. /usr/lib/synofurb/lib.sh
load_conf

active=
[ -r /sys/class/tty/console/active ] && read -r active < /sys/class/tty/console/active

{
    echo '# generated by /usr/lib/synofurb/mkinittab'
    echo '::sysinit:/usr/lib/synofurb/boot.sh'
    echo "::respawn:/usr/lib/synofurb/svc-net"
    echo "::respawn:/usr/lib/synofurb/svc-dropbear"
    echo "::respawn:/usr/lib/synofurb/svc-beacon"
    echo "::respawn:/usr/lib/synofurb/svc-watchdog"
    echo "::once:/usr/lib/synofurb/autorun"
    echo '::ctrlaltdel:/usr/bin/reboot'
    echo '::shutdown:/usr/lib/synofurb/on-shutdown'
    echo '::restart:/sbin/init'

    if [ "$AGENT_CONSOLE_SHELL" = 1 ]; then
        seen=
        for c in $active; do
            case $c in
                tty0) t=tty1 ;;               # the foreground VT; give it a stable name
                tty[0-9]*) t=$c ;;
                ttyS*|ttyAMA*|ttyUSB*|ttyACM*|ttyPS*|ttyLP*|ttyMSM*|ttyTHS*|ttymxc*) t=$c ;;
                *) continue ;;
            esac
            case " $seen " in *" $t "*) continue;; esac
            seen="$seen $t"
            [ -e "/dev/$t" ] || continue
            echo "$t::respawn:/usr/lib/synofurb/console-shell"
        done
        # nothing usable listed: fall back to /dev/console
        [ -n "$seen" ] || echo 'console::respawn:/usr/lib/synofurb/console-shell'
    fi
} > /etc/inittab

log info "inittab written; consoles active: '${active}' cmdline: $(cat /proc/cmdline)"
